<aside class="subscribe">
  <div>
    <p class="kicker">The GrilledMba Newsletter</p>
    <h2>Markets and MBA ideas, served hot.</h2>
    <p class="muted">New issues land on the newsletter page. Follow along however suits you.</p>
  </div>
  <div class="subscribe-actions">
    {% if site.newsletterSignupUrl %}
      <a class="btn" href="{{ site.newsletterSignupUrl }}" rel="noopener">Subscribe by email</a>
    {% endif %}
    <a class="btn {% if site.newsletterSignupUrl %}ghost{% endif %}" href="/feed.xml">Follow via RSS</a>
    {% if site.linkedin %}<a class="btn ghost" href="{{ site.linkedin }}" rel="noopener">Follow on LinkedIn</a>{% endif %}
  </div>
</aside>
