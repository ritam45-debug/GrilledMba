<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ excerpt or site.description }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ excerpt or site.description }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700;9..144,900&family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>
    try { var t = localStorage.getItem("gm-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="masthead">
    <div class="wrap masthead-row">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32"><rect x="3" y="9" width="26" height="3" rx="1.5"/><rect x="3" y="15" width="26" height="3" rx="1.5"/><rect x="3" y="21" width="26" height="3" rx="1.5"/><path d="M11 6c0-2 2-2 2-4M17 6c0-2 2-2 2-4" fill="none" stroke-width="1.6" stroke-linecap="round"/></svg>
        </span>
        <span class="brand-name">Grilled<em>Mba</em></span>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav" onclick="var n=document.getElementById('nav');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)">Menu</button>
      <nav id="nav" class="nav" aria-label="Main">
        {% set here = page.url %}
        <a href="/articles/" {% if here.startsWith('/articles') %}aria-current="page"{% endif %}>Articles</a>
        <a href="/newsletter/" {% if here.startsWith('/newsletter') %}aria-current="page"{% endif %}>Newsletter</a>
        <a href="/life/" {% if here.startsWith('/life') %}aria-current="page"{% endif %}>Life</a>
        <a href="/videos/" {% if here.startsWith('/videos') %}aria-current="page"{% endif %}>Videos</a>
        <a href="/topics/" {% if here.startsWith('/topics') %}aria-current="page"{% endif %}>Topics</a>
        <a href="/about/" {% if here.startsWith('/about') %}aria-current="page"{% endif %}>About</a>
        <button class="theme-btn" type="button" aria-label="Toggle dark mode" onclick="var d=document.documentElement;var dark=d.dataset.theme?d.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;d.dataset.theme=dark?'light':'dark';try{localStorage.setItem('gm-theme',d.dataset.theme)}catch(e){}">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" fill="currentColor"/></svg>
        </button>
      </nav>
    </div>
    <div class="ticker" aria-hidden="true"><div class="wrap">Markets · Finance · Marketing · Strategy · Operations · HR · Economics · Careers · Life in B-school</div></div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer-grid">
      <div>
        <p class="brand-name small">Grilled<em>Mba</em></p>
        <p class="muted">{{ site.tagline }}</p>
      </div>
      <div class="footer-links">
        <a href="/feed.xml">RSS feed</a>
        {% if site.linkedin %}<a href="{{ site.linkedin }}" rel="noopener">LinkedIn</a>{% endif %}
        {% if site.portfolio %}<a href="{{ site.portfolio }}" rel="noopener">Portfolio</a>{% endif %}
        <a href="/about/">About</a>
      </div>
      <p class="muted small">© {{ "" | year }} {{ site.author }}. Opinions are personal and not investment advice.</p>
    </div>
  </footer>
</body>
</html>
